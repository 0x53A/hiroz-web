FROM ros:lyrical

# Refresh the base's ROS libraries with the same package index as the new
# fixtures; mixing old service_msgs with newer generated type support can fail
# at load time with missing symbols.
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    ros-lyrical-demo-nodes-cpp \
    ros-lyrical-rmw-zenoh-cpp \
    ros-lyrical-rclpy \
    ros-lyrical-example-interfaces \
    && rm -rf /var/lib/apt/lists/*

COPY zenoh_session.json5 /config/zenoh_session.json5

COPY ros2_entrypoint.sh /ros2_entrypoint.sh
RUN chmod +x /ros2_entrypoint.sh
ENTRYPOINT ["/ros2_entrypoint.sh"]
